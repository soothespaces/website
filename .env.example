# Copy of the env vars the app reads. Don't fill this in by hand: run
#   npm run env:pull
# which writes real values to .env.local (git-ignored) from Vercel.

# Supabase project URL and publishable key (safe for the browser; RLS enforces access)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
